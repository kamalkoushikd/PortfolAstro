---
import LikeButton from "../React/LikeButton.tsx";

const year = new Date().getFullYear();

const links = [
  { label: "Work", href: "#work" },
  { label: "Repositories", href: "#repositories" },
  { label: "Toolkit", href: "#toolkit" },
  { label: "Contact", href: "#contact" },
];

const socials = [
  { label: "GitHub", href: "https://github.com/kamalkoushikd" },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/kamal-koushik-duppalapudi",
  },
  { label: "Email", href: "mailto:kamalkoushik24@gmail.com" },
];
---

<footer class="pt-14 pb-10 rule">
  <div class="shell">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
      <div class="col-span-2 md:col-span-2">
        <p class="display text-2xl">Kamal Koushik Duppalapudi</p>
        <p class="mt-2 text-sm" style="color: var(--muted)">
          Systems, security, and the low level.
        </p>
        <div class="mt-8">
          <LikeButton client:visible />
        </div>
      </div>

      <nav>
        <p class="eyebrow">Sections</p>
        <ul class="mt-4 space-y-2">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="foot-link link-underline text-sm">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav>
        <p class="eyebrow">Elsewhere</p>
        <ul class="mt-4 space-y-2">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="foot-link link-underline text-sm"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-14 pt-6 border-t flex flex-wrap items-center justify-between gap-3"
      style="border-color: var(--line)"
    >
      <p class="eyebrow">© {year} Kamal Koushik Duppalapudi</p>
      <p class="eyebrow">Astro · Tailwind · Vercel</p>
    </div>
  </div>
</footer>

<style>
  .foot-link {
    color: var(--muted);
    transition: color 0.3s ease;
  }

  .foot-link:hover {
    color: var(--fg);
  }
</style>
