---
const email = "kamalkoushik24@gmail.com";

const channels = [
  {
    label: "GitHub",
    value: "kamalkoushikd",
    href: "https://github.com/kamalkoushikd",
  },
  {
    label: "LinkedIn",
    value: "kamal-koushik-duppalapudi",
    href: "https://linkedin.com/in/kamal-koushik-duppalapudi",
  },
  {
    label: "Résumé",
    value: "PDF, one page",
    href: "/resume.pdf",
  },
];
---

<section id="contact" class="py-16 md:py-28 rule">
  <div class="shell">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-6">
        <p class="eyebrow reveal">Contact</p>
        <h2 class="display reveal mt-5 text-[clamp(2.2rem,5.5vw,4.5rem)]">
          Start a conversation.
        </h2>
        <p
          class="reveal mt-6 max-w-md"
          style="color: var(--muted); transition-delay: 60ms"
        >
          I'm open to internships, security work, and anything that involves
          reading a spec closely. If you have a protocol, a device or a
          benchmark that is misbehaving, I'd like to hear about it.
        </p>

        <a
          href={`mailto:${email}`}
          class="reveal display link-underline inline-block mt-8 text-[clamp(1.3rem,2.6vw,2.1rem)]"
          style="transition-delay: 100ms"
        >
          {email}
        </a>

        <dl class="reveal mt-12" style="transition-delay: 140ms">
          {
            channels.map((channel) => (
              <a
                href={channel.href}
                target="_blank"
                rel="noopener noreferrer"
                class="channel flex items-baseline justify-between gap-6 py-4 border-t"
                style="border-color: var(--line)"
              >
                <dt class="eyebrow">{channel.label}</dt>
                <dd class="text-sm flex items-center gap-2">
                  {channel.value}
                  <span class="channel-arrow">↗</span>
                </dd>
              </a>
            ))
          }
          <div
            class="flex items-baseline justify-between gap-6 py-4 border-t"
            style="border-color: var(--line)"
          >
            <span class="eyebrow">Based in</span>
            <span class="text-sm">Hyderabad, Telangana, India</span>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-6 lg:col-start-8">
        <form
          id="contact-form"
          action="https://formspree.io/f/xkgrevva"
          method="POST"
          class="reveal flex flex-col gap-6"
          style="transition-delay: 80ms"
        >
          <div class="field">
            <label class="eyebrow" for="from_name">Name</label>
            <input id="from_name" type="text" name="from_name" required />
          </div>
          <div class="field">
            <label class="eyebrow" for="reply_to">Email</label>
            <input id="reply_to" type="email" name="reply_to" required />
          </div>
          <div class="field">
            <label class="eyebrow" for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="submit-btn h-12 rounded-full text-sm">
            Send message
          </button>
        </form>

        <p id="form-message" class="hidden mt-6 text-sm" style="color: var(--accent)">
          Thanks, that's sent. I'll reply to the address you gave.
        </p>
        <p id="form-error" class="hidden mt-6 text-sm" style="color: #c2410c">
          Something went wrong sending that. Email me directly at {email}.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .channel {
    color: var(--fg);
    transition: color 0.3s ease;
  }

  .channel:hover {
    color: var(--accent);
  }

  .channel-arrow {
    color: var(--faint);
    transition: transform 0.3s ease;
    display: inline-block;
  }

  .channel:hover .channel-arrow {
    transform: translate(2px, -2px);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .field input,
  .field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-strong);
    color: var(--fg);
    font-family: inherit;
    font-size: 1rem;
    padding: 0.5rem 0;
    resize: none;
    transition: border-color 0.3s ease;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }

  .submit-btn {
    background-color: var(--fg);
    color: var(--bg);
    border: 1px solid var(--fg);
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      opacity 0.3s ease;
  }

  .submit-btn:hover:not(:disabled) {
    background-color: transparent;
    color: var(--fg);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: progress;
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const success = document.getElementById("form-message");
  const failure = document.getElementById("form-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button") as HTMLButtonElement;
    button.disabled = true;
    button.textContent = "Sending…";
    failure?.classList.add("hidden");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (!response.ok) throw new Error(await response.text());

      form.reset();
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    } catch (error) {
      console.error("Contact form failed:", error);
      failure?.classList.remove("hidden");
      button.disabled = false;
      button.textContent = "Send message";
    }
  });
</script>
