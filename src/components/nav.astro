---
const navItems = [
  { label: "Work", href: "#work" },
  { label: "Repositories", href: "#repositories" },
  { label: "Toolkit", href: "#toolkit" },
  { label: "Contact", href: "#contact" },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-[100]">
  <div class="shell">
    <div
      class="flex items-center justify-between h-16 md:h-20 border-b border-transparent transition-colors duration-300"
      id="header-inner"
    >
      <a
        href="#top"
        class="mono text-[0.8125rem] tracking-tight hover:opacity-60 transition-opacity"
        style="color: var(--fg)"
      >
        kamal&nbsp;koushik<span style="color: var(--accent)">.</span>
      </a>

      <nav class="flex items-center gap-6 md:gap-9">
        <ul class="hidden md:flex items-center gap-8">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="nav-link link-underline text-[0.8125rem] transition-colors"
                  style="color: var(--muted)"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle colour theme"
          class="grid place-items-center size-8 rounded-full transition-colors"
          style="color: var(--muted)"
        >
          <svg
            class="size-[1.05rem] icon-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="size-[1.05rem] icon-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>

        <a
          href="#contact"
          class="hidden md:inline-flex items-center h-9 px-4 text-[0.8125rem] rounded-full border transition-colors duration-300"
          style="border-color: var(--line-strong); color: var(--fg)"
          id="nav-cta"
        >
          Get in touch
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="md:hidden grid place-items-center size-8"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="burger"></span>
        </button>
      </nav>
    </div>
  </div>
</header>

<div id="mobile-menu" class="md:hidden" hidden>
  <div class="shell pt-28 pb-12">
    <ul class="space-y-1">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="menu-link display block py-3 text-4xl">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="mailto:kamalkoushik24@gmail.com"
      class="menu-link mono block mt-10 text-sm"
    >
      kamalkoushik24@gmail.com
    </a>
  </div>
</div>

<style>
  #site-header {
    backdrop-filter: blur(12px);
    background-color: transparent;
    transition: background-color 0.35s ease;
  }

  #site-header.stuck {
    background-color: color-mix(in srgb, var(--bg) 82%, transparent);
  }

  #site-header.stuck #header-inner {
    border-bottom-color: var(--line);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--fg) !important;
  }

  #theme-toggle:hover {
    color: var(--fg);
    background-color: var(--accent-soft);
  }

  #nav-cta:hover {
    background-color: var(--fg);
    color: var(--bg) !important;
    border-color: var(--fg);
  }

  :global(:root[data-theme="light"]) .icon-moon,
  :global(:root[data-theme="dark"]) .icon-sun {
    display: none;
  }

  /* Two-line burger that folds into a cross when the menu is open. */
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 18px;
    height: 1px;
    background-color: var(--fg);
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }

  .burger::before,
  .burger::after {
    content: "";
    position: absolute;
  }

  .burger {
    position: relative;
    background-color: transparent;
  }

  .burger::before {
    transform: translateY(-4px);
  }

  .burger::after {
    transform: translateY(4px);
  }

  #menu-toggle[aria-expanded="true"] .burger::before {
    transform: rotate(45deg);
  }

  #menu-toggle[aria-expanded="true"] .burger::after {
    transform: rotate(-45deg);
  }

  #mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background-color: var(--bg);
    animation: menu-in 0.3s ease;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .menu-link {
    color: var(--fg);
    transition: color 0.3s ease;
  }

  .menu-link:active {
    color: var(--accent);
  }
</style>

<script>
  const header = document.getElementById("site-header");

  const onScroll = () => {
    header?.classList.toggle("stuck", window.scrollY > 12);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Theme toggle. The initial value is resolved inline in the <head>.
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.getAttribute("data-theme") === "dark"
        ? "light"
        : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });

  // Mobile menu.
  const menuToggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const setMenu = (open: boolean) => {
    menu!.hidden = !open;
    menuToggle?.setAttribute("aria-expanded", String(open));
    menuToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.style.overflow = open ? "hidden" : "";
  };

  menuToggle?.addEventListener("click", () => {
    setMenu(menu!.hidden);
  });

  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => setMenu(false))
  );

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !menu!.hidden) setMenu(false);
  });

  // Highlight whichever section is currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const sections = document.querySelectorAll<HTMLElement>("section[id]");

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.getAttribute("id");
        links.forEach((link) =>
          link.classList.toggle("active", link.getAttribute("href") === `#${id}`)
        );
      });
    },
    { threshold: 0.25 }
  );
  sections.forEach((section) => spy.observe(section));
</script>
