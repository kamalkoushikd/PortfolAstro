---
import Laptop from "@/components/laptop.astro";

const meta = [
  { label: "Based in", value: "Hyderabad, India" },
  { label: "Studying", value: "B.Tech, IIT Hyderabad" },
  { label: "Working on", value: "Transport protocols and GPU power" },
];
---

<section
  id="top"
  class="relative overflow-hidden pt-32 md:pt-44 pb-16 md:pb-24"
>
  <div class="shell">
    <div class="hero-inner">
      <Laptop />

      <div class="hero-content">
        <p class="eyebrow reveal">Kamal Koushik Duppalapudi</p>

        <h1
          class="display reveal mt-6 md:mt-8 text-[clamp(2.6rem,9vw,7.5rem)]"
          style="transition-delay: 60ms"
        >
          I build the layers<br />
          <span style="color: var(--muted)">everything else</span> stands on.
        </h1>

        <div
          class="mt-10 md:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end"
        >
          <p
            class="reveal lg:col-span-6 text-lg md:text-xl leading-relaxed max-w-2xl"
            style="color: var(--muted); transition-delay: 120ms"
          >
            I write systems and security software. A transport protocol that
            beats QUIC on its own benchmarks, a reinforcement-learning governor
            for GPU clocks, a door lock that generates its own one-time
            passwords. Mostly
            <span style="color: var(--fg)">the low level</span>, and occasionally
            the web on top of it.
          </p>

          <div
            class="reveal lg:col-span-6 lg:justify-self-end w-full lg:max-w-md"
            style="transition-delay: 180ms"
          >
            <dl class="divide-y" style="border-color: var(--line)">
              {
                meta.map((item) => (
                  <div
                    class="flex items-baseline justify-between gap-6 py-3 border-t"
                    style="border-color: var(--line)"
                  >
                    <dt class="eyebrow">{item.label}</dt>
                    <dd class="text-sm text-right" style="color: var(--fg)">
                      {item.value}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <div
          class="reveal mt-12 md:mt-16 flex flex-wrap items-center gap-3"
          style="transition-delay: 240ms"
        >
          <a href="#work" class="btn-primary">
            Selected work
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a
            href="https://github.com/kamalkoushikd"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
              ></path>
            </svg>
            GitHub
          </a>
          <a
            href="/resume.pdf"
            download="kamal-koushik-resume.pdf"
            class="btn-ghost"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3v12M7 11l5 5 5-5M4 20h16"></path>
            </svg>
            Résumé
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The laptop is absolutely placed against this box, so it lands on the
     text's left edge rather than the shell's padding edge. */
  .hero-inner {
    position: relative;
  }

  /* Lifts the copy over the laptop watermark behind it. */
  .hero-content {
    position: relative;
    z-index: 10;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding-inline: 1.25rem;
    border-radius: 999px;
    font-size: 0.875rem;
    border: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .btn-primary {
    background-color: var(--fg);
    color: var(--bg);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
  }

  .btn-ghost {
    border-color: var(--line-strong);
    color: var(--fg);
  }

  .btn-ghost:hover {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
</style>
