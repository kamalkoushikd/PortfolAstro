---
const USER = "kamalkoushikd";

// Repos that are noise on a portfolio (profile config, etc.).
const HIDDEN = new Set(["kamalkoushik24", `${USER}.github.io`]);

// Where GitHub's own metadata sells a repo short.
const OVERRIDES: Record<string, { description?: string; language?: string }> = {
  "fuse-nw": { language: "C++" },
  PortfolAstro: { description: "This site. Astro, Tailwind, no framework." },
  canteenapp: { description: "Canteen ordering app for campus stalls." },
};

interface Repo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  pushed_at: string;
}

// Used when the GitHub API is unreachable or rate-limited at build time.
const fallback: Repo[] = [
  {
    name: "fuse-nw",
    description:
      "A from-scratch transport protocol built to outperform QUIC where it matters most.",
    html_url: "https://github.com/kamalkoushikd/fuse-nw",
    language: "C++",
    stargazers_count: 2,
    pushed_at: "2026-07-25T00:00:00Z",
  },
  {
    name: "PokerFrontend",
    description: "Poker with friends",
    html_url: "https://github.com/kamalkoushikd/PokerFrontend",
    language: "JavaScript",
    stargazers_count: 0,
    pushed_at: "2026-03-05T00:00:00Z",
  },
  {
    name: "CV_Project",
    description:
      "Computer vision for chemical and life sciences",
    html_url: "https://github.com/kamalkoushikd/CV_Project",
    language: "Python",
    stargazers_count: 0,
    pushed_at: "2025-12-01T00:00:00Z",
  },
  {
    name: "PortfolAstro",
    description: "This website, built with Astro",
    html_url: "https://github.com/kamalkoushikd/PortfolAstro",
    language: "Astro",
    stargazers_count: 0,
    pushed_at: "2025-10-29T00:00:00Z",
  },
  {
    name: "ntp-time",
    description:
      "Fetch accurate time from NTP servers directly in your terminal",
    html_url: "https://github.com/kamalkoushikd/ntp-time",
    language: "Rust",
    stargazers_count: 1,
    pushed_at: "2025-10-06T00:00:00Z",
  },
  {
    name: "SIS",
    description: "Security in intelligent systems",
    html_url: "https://github.com/kamalkoushikd/SIS",
    language: "Jupyter Notebook",
    stargazers_count: 0,
    pushed_at: "2025-11-27T00:00:00Z",
  },
  {
    name: "NumericalMethods",
    description: "Numerical methods, from prime sieves upward",
    html_url: "https://github.com/kamalkoushikd/NumericalMethods",
    language: "TypeScript",
    stargazers_count: 0,
    pushed_at: "2025-09-10T00:00:00Z",
  },
  {
    name: "ITCAttendance",
    description: "Attendance app for ITC contract workers",
    html_url: "https://github.com/kamalkoushikd/ITCAttendance",
    language: "TypeScript",
    stargazers_count: 0,
    pushed_at: "2025-06-18T00:00:00Z",
  },
  {
    name: "canteenapp",
    description: "Canteen ordering app",
    html_url: "https://github.com/kamalkoushikd/canteenapp",
    language: "TypeScript",
    stargazers_count: 0,
    pushed_at: "2025-06-12T00:00:00Z",
  },
  {
    name: "MSforChE",
    description: "Material science for chemical engineers",
    html_url: "https://github.com/kamalkoushikd/MSforChE",
    language: "JavaScript",
    stargazers_count: 0,
    pushed_at: "2025-03-19T00:00:00Z",
  },
];

let repos: Repo[] = fallback;
let live = false;

try {
  const response = await fetch(
    `https://api.github.com/users/${USER}/repos?per_page=100&sort=pushed`,
    {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "portfolastro-build",
      },
    }
  );

  if (response.ok) {
    const data = await response.json();
    const cleaned = (data as any[])
      .filter((repo) => !repo.fork && !repo.archived && !HIDDEN.has(repo.name))
      .map((repo) => ({
        name: repo.name,
        // Some repos carry the literal string "None" as a description.
        description:
          OVERRIDES[repo.name]?.description ??
          (repo.description && repo.description !== "None"
            ? repo.description
            : null),
        html_url: repo.html_url,
        language: OVERRIDES[repo.name]?.language ?? repo.language,
        stargazers_count: repo.stargazers_count,
        pushed_at: repo.pushed_at,
      }));
    if (cleaned.length) {
      repos = cleaned;
      live = true;
    }
  }
} catch {
  // Offline build, so the curated fallback above stands in.
}

repos.sort((a, b) => b.pushed_at.localeCompare(a.pushed_at));

const languageColors: Record<string, string> = {
  "C++": "#f34b7d",
  C: "#555555",
  Rust: "#dea584",
  Go: "#00add8",
  Python: "#3572a5",
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  Astro: "#ff5d01",
  HTML: "#e34c26",
  Java: "#b07219",
  "Jupyter Notebook": "#da5b0b",
  Svelte: "#ff3e00",
  Shell: "#89e051",
};

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", {
    month: "short",
    year: "numeric",
  });
---

<section id="repositories" class="py-16 md:py-28 rule">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6 pb-10 md:pb-14">
      <div>
        <p class="eyebrow reveal">Repositories</p>
        <h2 class="display reveal mt-5 text-[clamp(2rem,5vw,4rem)]">
          Everything public.
        </h2>
      </div>
      <p
        class="reveal max-w-sm text-sm"
        style="color: var(--muted); transition-delay: 80ms"
      >
        {repos.length} repositories{
          live ? ", pulled from GitHub when this page was built" : ""
        }. The private work (WattWiseG, CrowdGuard, the department site) is
        written up above instead.
      </p>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px repo-grid">
      {
        repos.map((repo) => (
          <li>
            <a
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="repo-card reveal flex flex-col h-full p-6"
            >
              <div class="flex items-start justify-between gap-4">
                <h3 class="mono text-[0.9rem]">{repo.name}</h3>
                <svg
                  class="repo-arrow size-4 shrink-0 mt-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17L17 7M8 7h9v9" />
                </svg>
              </div>

              <p class="mt-3 text-sm leading-relaxed flex-1" style="color: var(--muted)">
                {repo.description || "No description."}
              </p>

              <div class="flex items-center gap-4 mt-6 eyebrow">
                {repo.language && (
                  <span class="flex items-center gap-2">
                    <span
                      class="inline-block size-2 rounded-full"
                      style={`background-color: ${languageColors[repo.language] || "var(--line-strong)"}`}
                    />
                    {repo.language}
                  </span>
                )}
                {repo.stargazers_count > 0 && (
                  <span>★ {repo.stargazers_count}</span>
                )}
                <span class="ml-auto">{formatDate(repo.pushed_at)}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={`https://github.com/${USER}?tab=repositories`}
      target="_blank"
      rel="noopener noreferrer"
      class="reveal repo-all mt-10 flex items-center justify-center gap-3 h-14 text-sm rounded-full border"
    >
      Browse the full profile on GitHub
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 17L17 7M8 7h9v9"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  /* Hairline grid: cards sit on a shared 1px background. */
  .repo-grid {
    background-color: var(--line);
    border: 1px solid var(--line);
  }

  .repo-card {
    background-color: var(--bg);
    transition:
      background-color 0.35s ease,
      color 0.35s ease;
    color: var(--fg);
  }

  .repo-card:hover {
    background-color: var(--bg-raised);
  }

  .repo-arrow {
    color: var(--faint);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.35s ease;
  }

  .repo-card:hover .repo-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .repo-all {
    border-color: var(--line-strong);
    color: var(--fg);
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .repo-all:hover {
    background-color: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
</style>
